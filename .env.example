# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://smartride:password@postgres:5432/smartride

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT Auth ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_32_char_random_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── AI Services ───────────────────────────────────────────────────────────────
TRIAGE_SERVICE_URL=http://triage:8001

# ── Twilio SMS ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
# Prod compose: host path of the service-account key, mounted read-only into the
# backend. The file must exist (a missing file becomes an empty directory).
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-credentials.json

# FCM service-account key. In production it must be mounted into the container
# (the prod compose override makes the root filesystem read-only).
# FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ── Observability ─────────────────────────────────────────────────────────────
# Error tracking is off unless SENTRY_DSN is set.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# ENVIRONMENT=production
# LOG_LEVEL=INFO

# ── Admin Dashboard ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── App ───────────────────────────────────────────────────────────────────────
# DEV ONLY. DEBUG=true opens /metrics and allows CORS "*"; the production
# compose override and render.yaml force it to false.
DEBUG=true

# ── Local dev stack (docker compose up) ─────────────────────────────────────────────────
# Dev default; matches the test suite's TEST_DATABASE_URL. Postgres/Redis are
# published on 127.0.0.1 only. Use a real secret for anything else.
POSTGRES_PASSWORD=password
GRAFANA_USER=admin
# Required: compose refuses to start Grafana without it.
GRAFANA_PASSWORD=change_me

# ── Production (docker-compose.prod.yml requires these; use real secrets) ─────
# POSTGRES_PASSWORD, GRAFANA_USER/GRAFANA_PASSWORD and SECRET_KEY above also
# apply in production (SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))").
REDIS_PASSWORD=change_me
ALLOWED_ORIGINS=["https://admin.example.com"]
METRICS_TOKEN=change_me_long_random_token
# File holding METRICS_TOKEN for Prometheus: printf %s "$METRICS_TOKEN" > secrets/metrics_token
METRICS_TOKEN_FILE=./secrets/metrics_token
# Reverse-proxy IP or CIDR uvicorn trusts for X-Forwarded-For. A host-side proxy
# reaches the container from the compose network gateway, not 127.0.0.1
# (docker network inspect <project>_default). Rate limits key on this.
FORWARDED_ALLOW_IPS=172.16.0.0/12
# Password for the seeded admin (seed.py generates and prints one if unset)
ADMIN_PASSWORD=

# ── Optional tuning (every value shown is the built-in default) ──────────────────
# Set only what you need to change.
# PgBouncer in transaction-pooling mode needs the prepared-statement cache off.
# DB_DISABLE_PREPARED_CACHE=false
# Rate limits and credential-guessing defence. RATE_LIMITS_ENABLED=false is for
# end-to-end runs that sign in from one IP; never in production.
# RATE_LIMITS_ENABLED=true
# LOGIN_MAX_FAILURES=5
# LOGIN_PHONE_MAX_FAILURES=25
# LOGIN_LOCK_SECONDS=900
# LOGIN_KNOWN_ADDRESS_SECONDS=2592000
# SESSION_MAX_DAYS=30
# Seconds the admin dashboard summary is cached; 0 turns the cache off.
# SUMMARY_CACHE_SECONDS=15
# Fares and the platform's share of each fare.
# FARE_BASE_PKR=200.0
# FARE_PER_KM_PKR=40.0
# COMMISSION_RATE=0.10
# Dispatch. Drivers farther than DRIVER_SEARCH_RADIUS_KM are never considered.
# EMERGENCY_PIPELINE_TARGET_SECONDS=60.0
# DRIVER_SEARCH_RADIUS_KM=50.0
# DISPATCH_LOOP_ENABLED=true
# DISPATCH_LOOP_INTERVAL_SECONDS=15.0
# DISPATCH_RETRY_AFTER_SECONDS=30
# DISPATCH_CONCURRENCY=4
# DISPATCH_MAX_AGE_SECONDS=900
# SCHEDULED_DISPATCH_LEAD_MINUTES=30
# Minimum seconds on the pickup->hospital and hospital->completed legs before the
# next status is accepted. 0 disables it; production should set a real value so a
# ride cannot be completed instantly to book a fare.
# RIDE_MIN_TRANSITION_SECONDS=0
# "min_lat,min_lng,max_lat,max_lng". Pickups outside the box are rejected; empty
# disables the check. Production should set the area it serves.
# SERVICE_AREA_BBOX=23.0,60.5,37.5,78.0
