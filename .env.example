# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://smartride:password@postgres:5432/smartride

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT Auth ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_32_char_random_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Database pooling ──────────────────────────────────────────────────────────
# Set true only when connecting through PgBouncer in transaction-pooling mode.
DB_DISABLE_PREPARED_CACHE=false

# ── AI Services ───────────────────────────────────────────────────────────────
TRIAGE_SERVICE_URL=http://triage:8001

# ── Twilio SMS ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ── Observability (Sentry no-op unless SENTRY_DSN set) ────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ENVIRONMENT=development

# ── Admin Dashboard ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=true
# In production set explicit origins, e.g. ["https://your-admin.example.com"].
ALLOWED_ORIGINS=["*"]
EMERGENCY_PIPELINE_TARGET_SECONDS=60
LOG_LEVEL=INFO
