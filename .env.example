# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://smartride:password@postgres:5432/smartride

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT Auth ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_32_char_random_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── AI Services ───────────────────────────────────────────────────────────────
TRIAGE_SERVICE_URL=http://triage:8001

# ── Twilio SMS ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id

# ── Admin Dashboard ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=true

# ── Production (docker-compose.prod.yml requires these) ──────────────────────
POSTGRES_PASSWORD=change_me
REDIS_PASSWORD=change_me
ALLOWED_ORIGINS=["https://admin.example.com"]
METRICS_TOKEN=change_me_long_random_token
FORWARDED_ALLOW_IPS=127.0.0.1
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me
# Password for the seeded admin (seed.py generates and prints one if unset)
ADMIN_PASSWORD=
